# Firebase client config for the MTPB Violator PWA
# Copy this file to .env.local and fill in the values from the
# Firebase project console (Project settings > General > Your apps).
# .env.local is gitignored — never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the sample records from src/data/sample.js even when
# Firebase is configured. The app also falls back to them automatically
# while the Firebase values above are empty.
VITE_USE_SAMPLE_DATA=false

# Firestore collection holding violator profiles (document id = Auth uid).
# The shared MTPB project uses lowercase `violators`, so that it sits beside
# the admin app's own `users` collection without clashing with it.
# Leave empty to use `Violators`.
VITE_VIOLATORS_COLLECTION=violators

# ---- Payments ----
# demo      = simulated on this device (default)
# paymongo  = real PayMongo test mode through the Vercel backend (api/).
#             Needs the Firebase values above and the Vercel setup in README.
VITE_PAYMENTS_MODE=demo

# Leave empty when the app is deployed on Vercel together with api/.
# To test on localhost against your deployed backend, set it to your Vercel
# address, e.g. https://mtpb-violators.vercel.app
VITE_API_BASE_URL=
