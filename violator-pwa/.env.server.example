# Backend (Vercel) environment variables. Do NOT put these in .env.local.
# Add them in Vercel → your project → Settings → Environment Variables.

# PayMongo → Developers → API Keys → Secret key (TEST: starts with sk_test_)
PAYMONGO_SECRET_KEY=

# PayMongo → Developers → Webhooks → your endpoint → Secret key (whsk_...)
PAYMONGO_WEBHOOK_SECRET=

# Firebase → Project settings → Service accounts → Generate new private key.
# Paste the WHOLE contents of the downloaded .json file as the value.
FIREBASE_SERVICE_ACCOUNT=

# Your deployed app, e.g. https://mtpb-violators.vercel.app
APP_URL=

# Other sites allowed to call the API (comma-separated). Keep localhost for testing.
ALLOWED_ORIGINS=http://localhost:5173

# The app's own settings also have to be added in Vercel, because Vercel
# builds the app: VITE_FIREBASE_* (same values as .env.local) and
# VITE_PAYMENTS_MODE=paymongo
